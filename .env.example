# ── invoicer environment ─────────────────────────────────────────────
# Copy to .env (dev) or set in docker-compose.yml / your deployment
# environment. Everything is optional except where noted; unset values fall
# back to the dev-safe defaults shown next to each key.

# ── Site ─────────────────────────────────────────────────────────────
# Public origin of the deployment. Drives Better Auth's base URL, OAuth
# callback URLs and trusted origins. Set this in production.
#   GitHub OAuth App callback:   ${SITE_URL}/api/auth/callback/github
#   WeChat Open Platform callback: ${SITE_URL}/api/auth/callback/wechat
SITE_URL=http://localhost:10752

# ── Site admin ───────────────────────────────────────────────────────
# Comma-separated emails granted superadmin (mail delivery config, user
# list in Settings). Any email linked to an account counts.
# Leave EMPTY to use the bootstrap rule: the FIRST registered user is
# the superadmin.
SUPERADMIN_EMAILS=

# ── Secrets ──────────────────────────────────────────────────────────
# Better Auth signing secret, >= 32 chars. REQUIRED in production.
# Generate one with:  openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-char-random-string
# Legacy session secret (kept for compatibility; reuse the same value as
# BETTER_AUTH_SECRET when it is long enough).
SESSION_SECRET=

# ── Storage paths (Docker sets these; usually leave unset for dev) ──
# SQLite database file (WAL mode). Default: ./data/app.db
DB_PATH=
# Uploaded invoice files. Default: ./uploads
UPLOADS_DIR=
# tesseract.js OCR language data (chi_sim / chi_tra / eng). Default: ./tessdata
TESSDATA_DIR=

# ── OAuth (optional — a provider is enabled only when BOTH its
#    credentials are present) ─────────────────────────────────────────
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# WeChat Open Platform app: https://open.weixin.qq.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── Docker only ──────────────────────────────────────────────────────
# HTTP port inside/outside the container (docker-compose maps
# "${PORT:-10752}:10752"). Change together with the compose mapping.
# PORT=10752
