# ── invoicer environment ─────────────────────────────────────────────
# Copy to .env (dev) or set in your deployment environment. Everything is
# optional except where noted; unset values fall back to the dev-safe
# defaults shown next to each key.
#
# Dev database quickstart (local Postgres on the dedicated dev port so it
# never collides with an existing 5432 instance):
#   pnpm dev:db        # starts container invoicer-pg-dev on :15432
#   pnpm migration:run # applies the schema (also automatic on boot)

# ── Site ─────────────────────────────────────────────────────────────
# Public origin of the deployment. Drives Better Auth's base URL, OAuth
# callback URLs and trusted origins. Set this in production.
#   GitHub OAuth App callback:     ${SITE_URL}/api/auth/callback/github
#   WeChat Open Platform callback: ${SITE_URL}/api/auth/callback/wechat
SITE_URL=http://localhost:10752
# Overrides Better Auth's base URL when it must differ from SITE_URL
# (e.g. auth served under another host). Leave empty to use SITE_URL.
BETTER_AUTH_URL=

# ── Database (PostgreSQL) ────────────────────────────────────────────
# Full connection string. In docker-compose this is derived from the
# POSTGRES_* values below — set either, not both.
# Dev default: postgres://invoicer:invoicer@localhost:15432/invoicer
DATABASE_URL=
# The compose `postgres` service credentials (also gate the healthcheck).
POSTGRES_USER=invoicer
POSTGRES_PASSWORD=invoicer
POSTGRES_DB=invoicer
# Legacy SQLite source file — ONLY read by the one-time ETL script
# (pnpm tsx scripts/migrate-sqlite-to-pg.ts) when moving an old
# deployment's data into Postgres. Runtime no longer uses SQLite.
DB_PATH=./data/app.db

# ── Secrets ──────────────────────────────────────────────────────────
# Better Auth signing secret, >= 32 chars. REQUIRED in production.
# Generate one with:  openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-char-random-string
# Legacy session secret (kept for compatibility; reuse the same value as
# BETTER_AUTH_SECRET when it is long enough).
SESSION_SECRET=

# ── Site admin ───────────────────────────────────────────────────────
# Comma-separated emails granted superadmin (mail delivery config, user
# management in Settings). Any email linked to an account counts.
# Leave EMPTY to use the bootstrap rule: the FIRST registered user is
# the superadmin.
SUPERADMIN_EMAILS=

# ── Object storage (SeaweedFS / any S3-compatible) ──────────────────
# Setting S3_BUCKET moves uploaded invoice/order files to object storage
# with presigned downloads (bytes bypass the app); leave EMPTY to keep
# plain-disk storage under UPLOADS_DIR. Credentials must match the
# compose `seaweedfs` service.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Storage paths (Docker sets these; usually leave unset for dev) ──
# Uploaded invoice files (filesystem backend). Default: ./uploads
UPLOADS_DIR=
# tesseract.js OCR language data (chi_sim / chi_tra / eng). Default: ./tessdata
TESSDATA_DIR=

# ── OAuth (optional — a provider is enabled only when BOTH its
#    credentials are present) ─────────────────────────────────────────
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# WeChat Open Platform app: https://open.weixin.qq.com
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────
# Derived automatically: WEBAUTHN_* overrides > SITE_URL (origin + domain)
# > per-request host (works on localhost, tunnels, prod without any env).
# Set the overrides only when a proxy hides the real host from the server:
# WEBAUTHN_RP_ID=example.com            (registrable domain, port-less)
# WEBAUTHN_ORIGIN=https://example.com   (scheme + full host incl. port)
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ── OCR ─────────────────────────────────────────────────────────────
# PaddleOCR sidecar (PP-OCR, much stronger than tesseract for Chinese
# invoices). In Docker the default targets the compose-internal address
# (http://paddleocr:8080 — no host port published); enable the service
# with:  docker compose --profile ocr up -d
# Outside Docker (pnpm dev) leave EMPTY for the bundled tesseract.js —
# an unreachable sidecar falls back automatically.
PADDLEOCR_URL=
# Recognition languages for the bundled tesseract.js fallback. Each extra
# language roughly doubles recognition time; simplified Chinese + ASCII
# covers mainland invoices/receipts. Add chi_tra only if you process
# traditional-Chinese documents AND cannot run the PaddleOCR sidecar.
OCR_LANGS=

# ── Reverse proxy ────────────────────────────────────────────────────
# Set to 1 ONLY when a reverse proxy (nginx/Caddy) fronts the app: the
# incoming X-Forwarded-For chain is then trusted as the client IP for
# rate limiting. Unset (direct exposure), the socket address overwrites
# any client-supplied XFF — unspoofable.
TRUST_PROXY=
